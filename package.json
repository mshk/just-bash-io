{
  "name": "just-bash-io",
  "version": "0.1.0",
  "description": "Keep bulk data out of the LLM context: offload AI SDK tool results into a sandboxed just-bash workspace, and deliver formatted files straight to the user.",
  "keywords": [
    "ai",
    "ai-sdk",
    "agent",
    "tool",
    "bash",
    "sandbox",
    "just-bash",
    "mcp",
    "llm",
    "context"
  ],
  "license": "MIT",
  "author": "mshk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshk/just-bash-io.git"
  },
  "bugs": {
    "url": "https://github.com/mshk/just-bash-io/issues"
  },
  "homepage": "https://github.com/mshk/just-bash-io#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bash-tool": "^1.3.19",
    "just-bash": "^3.4.2"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "ai": "^6.0.141",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
